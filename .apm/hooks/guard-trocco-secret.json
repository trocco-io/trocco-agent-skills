{
  "description": "TROCCO API キーの値が漏れる Bash コマンドを実行前に block する（Claude Code / Codex 対応）",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.apm/hooks/scripts/guard-trocco-secret.sh",
            "timeout": 10,
            "async": false,
            "statusMessage": "checking for TROCCO API key exposure"
          }
        ]
      }
    ]
  }
}
